# This file is used to configure Maven behavior and settings

# The version of every module in this repository lives here and only here.
# The poms reference ${revision}; the release workflow matches the git tag
# against this line and refuses a -SNAPSHOT.
-Drevision=0.0.2-SNAPSHOT
